  "dependencies": [],
  "acceptance_criteria": [
    "Method signature is `public mutating func updateItem(atLine lineIndex: Int, newText: String)`",
    "Given `- [ ] *300 g* broccoli` at index 1, calling updateItem(atLine: 1, newText: \"*500 g* spinach\") yields `- [ ] *500 g* spinach`",
