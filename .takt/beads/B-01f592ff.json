{
  "bead_id": "B-01f592ff",
  "title": "dev-09: Parser \u2014 comment stripping",
  "agent_type": "developer",
  "description": "Implement comment recognition within the parser. Line comments: text from '--' to end-of-line is discarded. Single-line block comments: '[- ... -]' on the same line \u2014 text before '[' and after '-]' is concatenated. Multi-line block comments: '[- ... -]' spanning multiple lines \u2014 the entire spanned region including all intermediate content is discarded, and any @/# /~ components inside the comment block must NOT be added to the recipe collections.",
  "status": "done",
  "bead_type": "task",
  "parent_id": "B-2dfeba7e",
  "dependencies": [
    "B-7103482d"
  ],
  "acceptance_criteria": [
    "A line containing '-- comment text' has everything from '--' to EOL stripped; preceding text on the line is preserved.",
    "A line containing 'text [- comment -] more' produces 'text  more' (comment excised, surrounding text joined).",
    "A '[- ... -]' block spanning three lines removes all content between the delimiters and the delimiters themselves.",
    "An @ingredient written between '[- ' and ' -]' does NOT appear in Recipe.ingredients.",
    "swift build from Packages/CookbookCore/ succeeds."
  ],
  "linked_docs": [
    "specs/drafts/0001-cooklang-parser.md"
